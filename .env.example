# Local SQLite for dev; swap to PostgreSQL URL (Supabase/Neon) for production
DATABASE_URL="file:./dev.db"

# AI Provider (DeepSeek / OpenRouter / OpenAI — all OpenAI-compatible)
AI_PROVIDER="deepseek"
AI_BASE_URL="https://api.deepseek.com/v1"
AI_MODEL="deepseek-chat"
AI_API_KEY=""
# === Database (Local SQLite vs Cloud PostgreSQL) ===
# Local SQLite: DATABASE_URL="file:./dev.db" (run: npm run db:use:sqlite && npm run db:push)
# Cloud PostgreSQL (Neon / Supabase / Render):
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/farnavi?sslmode=require"
# Then run: npm run db:use:postgres && npm run db:push
COOKIE_SECURE="false"
